# ===============================================================
# MaanakAI (SIH 26108) - Production Environment Variables
# ===============================================================

# Server Ports
FRONTEND_PORT=80
BACKEND_PORT=8000
APPLICATION_ENV=PRODUCTION

# ---------------------------------------------------------------
# OPTION 1: Groq Cloud Provider (Fastest, low memory for cloud PaaS)
# ---------------------------------------------------------------
USE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# OPTION 2: Modal Serverless GPU (Serverless BharatGPT-3B on T4/L4 GPU)
# ---------------------------------------------------------------
BHARATGPT_MODAL_URL=

# ---------------------------------------------------------------
# OPTION 3: Local Sovereign GGUF Model (Requires 8GB+ RAM on host)
# ---------------------------------------------------------------
USE_BHARATGPT=true
BHARATGPT_MODEL_PATH=BharatGPT-3B-Indic.Q8_0.gguf

# ---------------------------------------------------------------
# Database Configuration
# Defaults to embedded SQLite (/app/data/standards.db)
# ---------------------------------------------------------------
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maanakai
POSTGRES_PORT=5432
